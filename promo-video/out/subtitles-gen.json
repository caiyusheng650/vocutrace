[
 {
  "from": 3,
  "to": 90,
  "text": "背单词最浪费时间的，不是记不住",
  "hl": []
 },
 {
  "from": 90,
  "to": 159,
  "text": "而是把时间花在了已经会的词",
  "hl": []
 },
 {
  "from": 173,
  "to": 224,
  "text": "和暂时怎么都记不住的词上。",
  "hl": []
 },
 {
  "from": 418,
  "to": 524,
  "text": "词溯，一款为中考、四级和雅思准备",
  "hl": [
   "词溯"
  ]
 },
 {
  "from": 522,
  "to": 610,
  "text": "的背单词 App。它想做的",
  "hl": []
 },
 {
  "from": 610,
  "to": 700,
  "text": "是让每一道题，都考在你最需要的地方。",
  "hl": []
 },
 {
  "from": 982,
  "to": 1074,
  "text": "以前的软件，把单词只记成两种状",
  "hl": []
 },
 {
  "from": 1074,
  "to": 1133,
  "text": "态：会，或者不会。",
  "hl": []
 },
 {
  "from": 1177,
  "to": 1240,
  "text": "可你真的只有会或者不会吗？",
  "hl": []
 },
 {
  "from": 1262,
  "to": 1341,
  "text": "ability，看英文选中文",
  "hl": []
 },
 {
  "from": 1341,
  "to": 1420,
  "text": "你每次都答对；反过来让你拼写",
  "hl": [
   "拼写"
  ]
 },
 {
  "from": 1420,
  "to": 1442,
  "text": "却写不出来。",
  "hl": []
 },
 {
  "from": 1485,
  "to": 1559,
  "text": "系统以为你已经会了，就再也不考",
  "hl": []
 },
 {
  "from": 1559,
  "to": 1654,
  "text": "它。词溯把一件事拆成三件：",
  "hl": [
   "词溯"
  ]
 },
 {
  "from": 1654,
  "to": 1745,
  "text": "看得出意思、用得上搭配、听音能拼",
  "hl": []
 },
 {
  "from": 1745,
  "to": 1833,
  "text": "写，三种能力，各记各的熟练度。",
  "hl": []
 },
 {
  "from": 1876,
  "to": 1961,
  "text": "衡量记住了没有，词溯看三个层面。",
  "hl": [
   "词溯"
  ]
 },
 {
  "from": 2026,
  "to": 2143,
  "text": "第一层，隔多久再考：答对，间隔从一",
  "hl": [
   "间隔"
  ]
 },
 {
  "from": 2142,
  "to": 2212,
  "text": "天到六天，再往后慢慢拉长；",
  "hl": []
 },
 {
  "from": 2227,
  "to": 2281,
  "text": "答错，就从头再来。",
  "hl": []
 },
 {
  "from": 2325,
  "to": 2443,
  "text": "第二层，你有多熟：答对加零点一五",
  "hl": [
   "零点一五"
  ]
 },
 {
  "from": 2443,
  "to": 2536,
  "text": "答错减零点二，一次失误，会抵消不",
  "hl": [
   "零点二"
  ]
 },
 {
  "from": 2535,
  "to": 2558,
  "text": "止一次积累。",
  "hl": []
 },
 {
  "from": 2600,
  "to": 2711,
  "text": "第三层，忘得有多快：放得越久忘得",
  "hl": []
 },
 {
  "from": 2708,
  "to": 2785,
  "text": "越多，大约七天就忘掉一半。",
  "hl": [
   "七天",
   "一半"
  ]
 },
 {
  "from": 2826,
  "to": 2916,
  "text": "这三层，分别回答：隔多久再考",
  "hl": []
 },
 {
  "from": 2931,
  "to": 2997,
  "text": "哪种能力弱、现在有多危险。",
  "hl": []
 },
 {
  "from": 3039,
  "to": 3118,
  "text": "每次出题，都先给备选的词算个分",
  "hl": []
 },
 {
  "from": 3118,
  "to": 3212,
  "text": "数：零点四乘忘了的可能，加零点四",
  "hl": [
   "零点四"
  ]
 },
 {
  "from": 3212,
  "to": 3308,
  "text": "乘薄弱程度，减零点一乘难度不合",
  "hl": []
 },
 {
  "from": 3308,
  "to": 3377,
  "text": "适，再减零点一乘今天有多累。",
  "hl": []
 },
 {
  "from": 3419,
  "to": 3529,
  "text": "然后选分数最高的一道。太难和太",
  "hl": []
 },
 {
  "from": 3529,
  "to": 3617,
  "text": "简单，都被同一条规则压下去；",
  "hl": []
 },
 {
  "from": 3617,
  "to": 3695,
  "text": "连续答错，难题自动让路。",
  "hl": []
 },
 {
  "from": 3738,
  "to": 3821,
  "text": "产品里直接能看到：连着答错几题",
  "hl": []
 },
 {
  "from": 3834,
  "to": 3911,
  "text": "后面的题变简单；会认不会拼的词",
  "hl": []
 },
 {
  "from": 3924,
  "to": 4008,
  "text": "拼写题变多；答错的进错题本",
  "hl": [
   "拼写",
   "错题本"
  ]
 },
 {
  "from": 4008,
  "to": 4043,
  "text": "答对自动移出。",
  "hl": []
 },
 {
  "from": 4087,
  "to": 4151,
  "text": "一万零四百七十九条词条",
  "hl": [
   "一万零四百七十九条"
  ]
 },
 {
  "from": 4151,
  "to": 4248,
  "text": "都带音标、词根助记和易混词提醒",
  "hl": []
 },
 {
  "from": 4266,
  "to": 4344,
  "text": "打开就是今天的新词和该复习的",
  "hl": []
 },
 {
  "from": 4341,
  "to": 4396,
  "text": "错词，点一下就能开始。",
  "hl": []
 },
 {
  "from": 4439,
  "to": 4518,
  "text": "不用注册就能先试，也能用邮箱验",
  "hl": []
 },
 {
  "from": 4517,
  "to": 4623,
  "text": "证码登录，看一次广告送三天会员",
  "hl": [
   "三天"
  ]
 },
 {
  "from": 4623,
  "to": 4723,
  "text": "没有付费墙。同一套代码，还能装成",
  "hl": []
 },
 {
  "from": 4723,
  "to": 4749,
  "text": "安卓 App。",
  "hl": [
   "安卓"
  ]
 },
 {
  "from": 4790,
  "to": 4859,
  "text": "开发的时候，TRAE 帮我把零散",
  "hl": [
   "TRAE"
  ]
 },
 {
  "from": 4858,
  "to": 4937,
  "text": "的样式收成了一套统一的设计",
  "hl": []
 },
 {
  "from": 4937,
  "to": 5004,
  "text": "还把答题从三步缩短到两步",
  "hl": []
 },
 {
  "from": 5004,
  "to": 5079,
  "text": "也帮我从广告不显示，一路查到最",
  "hl": []
 },
 {
  "from": 5079,
  "to": 5100,
  "text": "根本的原因。",
  "hl": []
 },
 {
  "from": 5144,
  "to": 5216,
  "text": "一个推荐做得好不好，不在于技术",
  "hl": []
 },
 {
  "from": 5215,
  "to": 5302,
  "text": "多复杂，而在于有没有真正看清",
  "hl": []
 },
 {
  "from": 5315,
  "to": 5388,
  "text": "每个学生到底哪里会、哪里不会。",
  "hl": []
 },
 {
  "from": 5430,
  "to": 5518,
  "text": "词溯，把背单词的时间，还给学生。",
  "hl": [
   "词溯"
  ]
 }
]